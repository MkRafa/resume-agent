# ---- Free-tier providers -------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey  (no card, ~30s)
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys  (no card) - used for the VERIFIER,
# deliberately a different model family than the tailorer.
GROQ_API_KEY=

# ---- Model routing -------------------------------------------------------
# Any LiteLLM-supported id. Swap to anthropic/* or openai/* for production.
MODEL_EXTRACT=gemini/gemini-2.0-flash
MODEL_PARSE=gemini/gemini-2.0-flash
MODEL_MATCH=gemini/gemini-2.0-flash
MODEL_TAILOR=gemini/gemini-2.0-flash
MODEL_VERIFY=groq/llama-3.3-70b-versatile

# Local, zero-PII-egress alternative (requires `ollama serve` + `ollama pull`).
# Note: running every node locally means the verifier is no longer a different
# model family from the tailorer, which is the whole point of the verify pass.
# Good for plumbing tests and PII-sensitive extraction; not a quality signal.
# MODEL_EXTRACT=ollama/qwen2.5:7b
# MODEL_VERIFY=ollama/qwen2.5:7b

# ---- Behaviour -----------------------------------------------------------
PHONE_DEFAULT_REGION=IN
REDACT_PII=true
LOG_COSTS=true
